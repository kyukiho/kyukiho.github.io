---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="页面走丢了" description="404 Not Found">
  <main class="page-main container">
    <section class="notfound glass">
      <div class="big">404</div>
      <p>这里什么都没有～页面可能已被移动或删除。</p>
      <a href="/" class="btn">返回首页</a>
    </section>
  </main>
</BaseLayout>

<style>
  .notfound {
    padding: 60px 30px;
    text-align: center;
  }
  .big {
    font-size: 5rem;
    font-weight: 800;
    color: var(--accent);
    line-height: 1;
    margin-bottom: 12px;
  }
  .notfound p {
    color: var(--text-soft);
    margin-bottom: 24px;
  }
</style>
