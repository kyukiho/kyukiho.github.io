---
import type { GetStaticPaths } from 'astro';
import { render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import FormattedDate from '../../components/FormattedDate.astro';
import { getPublishedPosts, tagSlug } from '../../utils/posts';

export const getStaticPaths = (async () => {
  const posts = await getPublishedPosts();
  return posts.map((post) => ({
    params: { slug: post.id },
    props: { post },
  }));
}) satisfies GetStaticPaths;

const { post } = Astro.props;
const { title, date, description, tags, category } = post.data;
const { Content } = await render(post);
---

<BaseLayout title={title} description={description}>
  <main class="page-main container">
    <article class="post glass">
      <header class="post-header">
        <h1 class="post-title">{title}</h1>
        <div class="post-meta">
          <FormattedDate date={date} />
          {category && <span class="dot">·</span>}
          {category && <span>{category}</span>}
        </div>
        {
          tags.length > 0 && (
            <div class="post-tags">
              {tags.map((tag) => (
                <a href={`/tags/${tagSlug(tag)}`} class="tag">
                  #{tag}
                </a>
              ))}
            </div>
          )
        }
      </header>
      <div class="prose">
        <Content />
      </div>
    </article>
    <div class="back">
      <a href="/blog" class="btn">← 返回文章列表</a>
    </div>
  </main>
</BaseLayout>

<style>
  .post {
    padding: 38px 40px;
  }
  .post-header {
    margin-bottom: 26px;
    padding-bottom: 22px;
    border-bottom: 1px solid var(--divider);
  }
  .post-title {
    margin: 0 0 12px;
    font-size: 2rem;
    font-weight: 800;
    line-height: 1.3;
  }
  .post-meta {
    color: var(--text-muted);
    font-size: 0.9rem;
    display: flex;
    align-items: center;
    gap: 6px;
  }
  .post-tags {
    margin-top: 14px;
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }
  .back {
    margin-top: 28px;
    text-align: center;
  }
  @media (max-width: 640px) {
    .post {
      padding: 26px 22px;
    }
    .post-title {
      font-size: 1.6rem;
    }
  }
</style>
