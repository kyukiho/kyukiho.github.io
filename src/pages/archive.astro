---
import BaseLayout from '../layouts/BaseLayout.astro';
import FormattedDate from '../components/FormattedDate.astro';
import { getArchive, getPublishedPosts } from '../utils/posts';

const archive = await getArchive();
const total = (await getPublishedPosts()).length;
---

<BaseLayout title="归档" description="按时间归档的全部文章">
  <main class="page-main container">
    <h1 class="page-title">归档</h1>
    <p class="page-subtitle">共 {total} 篇文章</p>

    {
      archive.map((yearGroup) => (
        <section class="year-block">
          <h2 class="year">{yearGroup.year}</h2>
          {yearGroup.months.map((monthGroup) => (
            <div class="month-block glass">
              <div class="month-label">{monthGroup.month} 月</div>
              <ul class="timeline">
                {monthGroup.posts.map((post) => (
                  <li class="tl-item">
                    <a href={`/blog/${post.id}`} class="tl-link">
                      <span class="tl-date">
                        <FormattedDate date={post.data.date} short />
                      </span>
                      <span class="tl-title">{post.data.title}</span>
                    </a>
                  </li>
                ))}
              </ul>
            </div>
          ))}
        </section>
      ))
    }
    {archive.length === 0 && <p class="empty">还没有文章。</p>}
  </main>
</BaseLayout>

<style>
  .year-block {
    margin-bottom: 30px;
  }
  .year {
    font-size: 1.5rem;
    font-weight: 800;
    color: var(--accent-strong);
    margin: 0 0 12px;
  }
  .month-block {
    padding: 16px 22px;
    margin-bottom: 14px;
  }
  .month-label {
    font-size: 0.85rem;
    color: var(--text-muted);
    font-weight: 600;
    margin-bottom: 8px;
  }
  .timeline {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .tl-link {
    display: flex;
    gap: 16px;
    align-items: baseline;
    padding: 8px 6px;
    border-radius: 8px;
    color: var(--text);
    transition: background 0.2s ease;
  }
  .tl-link:hover {
    background: var(--accent-soft);
  }
  .tl-date {
    font-size: 0.82rem;
    color: var(--text-muted);
    white-space: nowrap;
    flex-shrink: 0;
    min-width: 78px;
  }
  .tl-title {
    font-size: 0.98rem;
  }
  .empty {
    color: var(--text-muted);
  }
</style>
