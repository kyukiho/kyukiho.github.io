---
import { SITE_TITLE, SIDEBAR_LINKS, AUTHOR } from '../consts';

const icons: Record<string, string> = {
  article:
    '<path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path><polyline points="14 2 14 8 20 8"></polyline><line x1="8" y1="13" x2="16" y2="13"></line><line x1="8" y1="17" x2="16" y2="17"></line>',
  archive:
    '<polyline points="21 8 21 21 3 21 3 8"></polyline><rect x="1" y="3" width="22" height="5"></rect><line x1="10" y1="12" x2="14" y2="12"></line>',
  tag: '<path d="M20.59 13.41l-7.17 7.17a2 2 0 0 1-2.83 0L2 12V2h10l8.59 8.59a2 2 0 0 1 0 2.82z"></path><line x1="7" y1="7" x2="7.01" y2="7"></line>',
  globe:
    '<circle cx="12" cy="12" r="10"></circle><line x1="2" y1="12" x2="22" y2="12"></line><path d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"></path>',
  smile:
    '<circle cx="12" cy="12" r="10"></circle><path d="M8 14s1.5 2 4 2 4-2 4-2"></path><line x1="9" y1="9" x2="9.01" y2="9"></line><line x1="15" y1="9" x2="15.01" y2="9"></line>',
};
---

<aside class="sidebar glass">
  <div class="profile">
    <div class="avatar">
      <img src="/images/avatar.jpg" alt={AUTHOR} />
    </div>
    <div>
      <div class="name">{AUTHOR}</div>
      <div class="tagline">{SITE_TITLE}</div>
    </div>
  </div>
  <div class="section-label">GENERAL</div>
  <nav class="side-nav">
    {
      SIDEBAR_LINKS.map((link) => (
        <a href={link.href} class="side-link">
          <svg
            width="18"
            height="18"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
            set:html={icons[link.icon] ?? ''}
          />
          <span>{link.label}</span>
        </a>
      ))
    }
  </nav>
</aside>

<style>
  .sidebar {
    padding: 22px;
    display: flex;
    flex-direction: column;
    gap: 6px;
    height: 100%;
  }
  .profile {
    display: flex;
    align-items: center;
    gap: 12px;
    margin-bottom: 14px;
  }
  .avatar {
    width: 46px;
    height: 46px;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 24px;
    background: var(--accent-soft);
    flex-shrink: 0;
    overflow: hidden;
  }
  .avatar img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .name {
    font-weight: 700;
    font-size: 1.1rem;
    color: var(--text);
  }
  .tagline {
    font-size: 0.78rem;
    color: var(--text-muted);
  }
  .section-label {
    font-size: 0.72rem;
    letter-spacing: 0.08em;
    color: var(--text-muted);
    margin: 6px 0 4px;
    font-weight: 600;
  }
  .side-nav {
    display: flex;
    flex-direction: column;
    gap: 4px;
  }
  .side-link {
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 10px 14px;
    border-radius: 14px;
    color: var(--text-soft);
    font-size: 0.95rem;
    transition: background 0.2s ease, color 0.2s ease;
  }
  .side-link:hover {
    background: var(--accent-soft);
    color: var(--accent-strong);
  }
</style>
